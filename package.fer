let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'Curl',
        desc = 'Curl C library bindings for Feral.',
        version = '0.2.0',
        feral = '>=2.2.1',
        author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
    );

    pkg.requires('libcurl', version = '>=8.21.0');

    # Only used by test :P
    pkg.requires('Progress', version = '~0.2.0', feral = true);

    let curlTarget = pkg.addTarget('Curl');
    curlTarget.findHeaders(info.pkgRoot / 'lib', '(.*).hpp');
    curlTarget.findSources(info.pkgRoot / 'lib', '(.*).cpp');

    return feral.ok(pkg);
};